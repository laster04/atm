# Database connection string
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# JWT secret for authentication - use a strong random string in production
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server port
PORT=3001

# CORS origin - set to your frontend domain in production
# Example: https://your-frontend-domain.com
# Leave empty or use * for development (allows all origins)
CORS_ORIGIN=https://your-frontend-domain.com

# Frontend URL for email links
APP_URL=http://localhost:5173
# Public site the sitemap's URLs point at (defaults to https://www.atm-online.cz)
SITE_URL=https://www.atm-online.cz

# Sign-in with Google: the OAuth 2.0 Web client id from Google Cloud Console
# (APIs & Services > Credentials), with the app's address among its
# Authorized JavaScript origins. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Resend Email Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxx

# Email sender address
# Use 'onboarding@resend.dev' for testing, or your verified domain for production
EMAIL_FROM="ATM <onboarding@resend.dev>"

# Where contact-form messages are announced (comma-separated).
# Leave empty to notify every active administrator instead.
SUPPORT_EMAIL=

# Set when the API runs behind a reverse proxy, so the contact form's rate
# limit sees real client addresses: "true", a hop count such as 1, or addresses.
TRUST_PROXY=

# EU VAT ID checks (VIES). Conesoft's own VAT ID, e.g. CZ12345678: with it VIES
# issues a consultation number, the evidence for charging 0 % under reverse
# charge. Without it checks still work, but carry no consultation number.
VIES_REQUESTER_VAT=
# Only to point at a test double; the defaults are the public services.
# VIES_API_URL=https://ec.europa.eu/taxation_customs/vies/rest-api
# ARES_API_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest


# File storage (logos now; invoices and tournament documents later).
# "local" keeps files on disk under STORAGE_LOCAL_DIR and serves public ones
# itself at /api/uploads - for development and tests. "s3" is Cloudflare R2 (or
# any S3-compatible store) and needs every S3_* variable.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Base URL public files are reached at. Local default: /api/uploads (through the
# Vite proxy). With R2: the public bucket's custom domain, e.g. https://files.atm-online.cz
STORAGE_PUBLIC_URL=
# R2: https://<account id>.eu.r2.cloudflarestorage.com for an EU-jurisdiction bucket
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Logos and other public files; has the public custom domain.
S3_PUBLIC_BUCKET=
# Invoices; never public, reached through signed links only.
S3_PRIVATE_BUCKET=
