generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role only separates a global administrator from a regular account. What a
// user may manage comes from the manager relations below (League.manager,
// Team.manager, TournamentSeries.manager), never from this enum.
enum Role {
  ADMIN
  USER
}

enum SeasonStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

// Who may see a league, a season or a tournament series.
//
// UNLISTED is what an organiser wants while a draw is being built: shareable
// with the clubs involved, absent from every public listing. Visibility is
// inherited downwards and the strictest level wins, so a PRIVATE league hides
// every season, game, table and archive under it whatever those say.
enum Visibility {
  PUBLIC // anyone, and listed
  UNLISTED // anyone with the link, never listed
  PRIVATE // the people who manage it, and nobody else
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
}

enum SportType {
  FOOTBALL
  BASKETBALL
  VOLLEYBALL
  HOCKEY
  TENNIS
  HANDBALL
  FLOORBALL
  OTHER
}

// What a player plays. One list for every sport so a roster row keeps a real
// value that end-of-season tables can group by; which of these a player may
// hold depends on the sport (src/utils/playerPositions.ts). Free text is gone
// on purpose: "Obránce", "obránce" and "D" would be three positions in a table.
enum PlayerPosition {
  GOALIE
  DEFENDER
  MIDFIELDER
  FORWARD
  WING
  BACK
  PIVOT
  GUARD
  CENTER
  SETTER
  OUTSIDE_HITTER
  OPPOSITE
  MIDDLE_BLOCKER
  LIBERO
}

model User {
  id                          String    @id @default(uuid())
  email                       String    @unique
  password                    String
  name                        String
  role                        Role      @default(USER)
  active                      Boolean   @default(true)
  emailVerified               Boolean   @default(false) @map("email_verified")
  emailVerifiedAt             DateTime? @map("email_verified_at")
  activationToken             String?   @unique @map("activation_token")
  activationTokenExpiresAt    DateTime? @map("activation_token_expires_at")
  passwordResetToken          String?   @unique @map("password_reset_token")
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at")
  // Opt-out for the round summary. Transactional mail (activation, password
  // reset, invitations) ignores it - that is post the account asked for.
  emailDigest                 Boolean   @default(true) @map("email_digest")
  // Language of the e-mails the user gets; follows the language they last
  // picked in the app. One of backend/src/i18n LOCALES.
  locale                      String    @default("cs")
  onboardingCompletedAt       DateTime? @map("onboarding_completed_at")
  teamTourCompletedAt         DateTime? @map("team_tour_completed_at")
  lastLoggedInAt              DateTime? @map("last_logged_in_at")
  // Newest release note the user has opened /updates past; drives the unread dot.
  updatesSeenAt               DateTime? @map("updates_seen_at")
  // May change prices, VAT rates, plan limits and the OSS switch. Other admins
  // only see them. Set by migration on admin@atm.cz, never by comparing emails.
  canManagePricing            Boolean   @default(false) @map("can_manage_pricing")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  managedLeagues          League[]
  managedTeams            Team[]
  managedTournamentSeries TournamentSeries[]
  playerProfiles          Player[]
  recordedMatchEvents     MatchEvent[]       @relation("MatchEventRecorder")
  confirmedGames          Game[]             @relation("GameConfirmer")
  auditEntries            AuditLog[]         @relation("AuditActor")
  createdTeamEvents       TeamEvent[]        @relation("TeamEventCreator")
  attendanceResponses     Attendance[]       @relation("AttendanceResponder")
  sentDigests             SeasonDigest[]     @relation("DigestSender")
  supportTickets          SupportTicket[]
  sentManagerInvites      ManagerInvite[]    @relation("InviteSender")
  registrations           Registration[]     @relation("RegistrationApplicant")
  decidedRegistrations    Registration[]     @relation("RegistrationDecider")
  promotedRegistrations   Registration[]     @relation("RegistrationPromoter")
  priceVersions           ProductPrice[]     @relation("PriceAuthor")
  vatRateVersions         VatRate[]          @relation("VatRateAuthor")
  planLimitVersions       PlanLimit[]        @relation("PlanLimitAuthor")
  vatChecks               VatCheck[]         @relation("VatCheckRequester")
  uploadedFiles           StoredFile[]       @relation("FileUploader")
  organizerPlans          OrganizerPlan[]    @relation("OrganizerPlanHolder")
  payments                Payment[]          @relation("PaymentPayer")
  confirmedPayments       Payment[]          @relation("PaymentConfirmer")

  // The admin user list sorts and filters on these.
  @@index([createdAt])
  @@index([lastLoggedInAt])
  @@map("users")
}

model League {
  id          String     @id @default(uuid())
  name        String
  sportType   SportType  @default(OTHER) @map("sport_type")
  logo        String?
  description String?
  // Scoring override for every season of this league. Null falls back to the
  // sport default in services/scoring/policy.ts. A season may override again.
  scoring     Json?
  visibility  Visibility @default(PUBLIC)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  managerId String? @map("manager_id")
  manager   User?   @relation(fields: [managerId], references: [id], onDelete: SetNull)

  seasons        Season[]
  managerInvites ManagerInvite[]

  @@map("leagues")
}

model Season {
  id         String       @id @default(uuid())
  name       String
  startDate  DateTime     @map("start_date")
  endDate    DateTime     @map("end_date")
  status     SeasonStatus @default(DRAFT)
  // Overrides the league's scoring for this season only; null inherits.
  scoring    Json?
  // A new season starts unlisted and is published once its draw is ready.
  // Replaces the old rule that hid DRAFT seasons from lists; status now only
  // says where the season is in its life, not who may see it.
  visibility Visibility   @default(UNLISTED)
  archivedAt DateTime?    @map("archived_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  leagueId String @map("league_id")
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  seasonTeams SeasonTeam[]
  games       Game[]

  archivedStandings   SeasonArchiveStanding[]
  archivedPlayerStats SeasonArchivePlayerStat[]
  digests             SeasonDigest[]
  groups              SeasonGroup[]
  playoffSeries       PlayoffSeries[]
  registrationWindow  RegistrationWindow?

  @@map("seasons")
}

// A division or group inside one season. A league that runs two divisions, or a
// season split into groups before a playoff, is one season with several of
// these rather than several seasons that have to be kept in step by hand.
model SeasonGroup {
  id       String @id @default(uuid())
  name     String
  // Display order, so "Group A" stays above "Group B" whatever they are called.
  position Int    @default(0)

  seasonId String @map("season_id")
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  seasonTeams SeasonTeam[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, name])
  @@map("season_groups")
}

model SeasonTeam {
  id        String   @id @default(uuid())
  seasonId  String   @map("season_id")
  teamId    String   @map("team_id")
  createdAt DateTime @default(now()) @map("created_at")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Which division this team plays in, within this season. Null means the
  // season is not divided, or the team has not been placed yet. Deleting a
  // group returns its teams to the season rather than dropping them from it.
  groupId String?      @map("group_id")
  group   SeasonGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([seasonId, teamId])
  @@index([groupId])
  @@map("season_teams")
}

model Team {
  id           String   @id @default(uuid())
  name         String
  logo         String?
  primaryColor String?  @map("primary_color")
  /// Invite link to the team's own group chat (WhatsApp, Messenger...). Anyone
  /// holding it can join the group, so the client omits it everywhere
  /// (config/database.ts) and only the team's people are handed it.
  chatUrl      String?  @map("chat_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  managerId String? @map("manager_id")
  manager   User?   @relation(fields: [managerId], references: [id], onDelete: SetNull)

  seasonTeams SeasonTeam[]
  players     Player[]
  homeGames   Game[]       @relation("HomeTeam")
  awayGames   Game[]       @relation("AwayTeam")
  matchEvents MatchEvent[] @relation("MatchEventTeam")
  teamEvents  TeamEvent[]

  archivedStandings   SeasonArchiveStanding[]
  archivedPlayerStats SeasonArchivePlayerStat[]
  managerInvites      ManagerInvite[]
  playoffHome         PlayoffSeries[]           @relation("PlayoffSeriesHome")
  playoffAway         PlayoffSeries[]           @relation("PlayoffSeriesAway")
  playoffWins         PlayoffSeries[]           @relation("PlayoffSeriesWinner")
  registrations       Registration[]            @relation("RegistrationTeam")
  applications        Registration[]            @relation("RegistrationExistingTeam")

  @@map("teams")
}

/// An invitation to manage a team or a league, or to take a player's place on
/// a roster. Exactly one of teamId / leagueId / playerId is set. The relation
/// (Team.managerId / League.managerId / Player.userId) is only written when the
/// invitee accepts; until then the invite is what the inviter sees as
/// "Invited". Only a hash of the link's token is stored, so a lost link is
/// replaced by resending, never recovered.
model ManagerInvite {
  id          String    @id @default(uuid())
  teamId      String?   @map("team_id")
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leagueId    String?   @map("league_id")
  league      League?   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerId    String?   @map("player_id")
  player      Player?   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  email       String
  name        String
  locale      String    @default("cs")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  sentAt      DateTime  @default(now()) @map("sent_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  invitedById String?   @map("invited_by_id")
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([teamId])
  @@index([leagueId])
  @@index([playerId])
  @@map("manager_invites")
}

model Player {
  id        String          @id @default(uuid())
  name      String
  number    Int?
  position  PlayerPosition?
  bornYear  Int?            @map("born_year")
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  teamId    String                @map("team_id")
  team      Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  statistic PlayerGameStatistic[] @relation("PlayerStatistic")

  // A roster row exists whether or not the person behind it has an account.
  // Claiming links the two so the player can sign in and see their own team;
  // unlinking must leave the roster row and its history intact.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  archivedStats SeasonArchivePlayerStat[]

  matchEvents          MatchEvent[]    @relation("MatchEventPlayer")
  matchEventAssists    MatchEvent[]    @relation("MatchEventAssist")
  matchEventAssists2nd MatchEvent[]    @relation("MatchEventSecondaryAssist")
  attendances          Attendance[]
  invites              ManagerInvite[]

  // One person may hold a roster spot in several teams, but only one per team.
  @@unique([teamId, userId])
  @@index([userId])
  @@map("players")
}

model Game {
  id                  String     @id @default(uuid())
  date                DateTime?
  location            String?
  homeScore           Int?       @map("home_score")
  awayScore           Int?       @map("away_score")
  // The score of each part of the game, in order: periods, halves, quarters or
  // sets, as the sport has them (services/sports/profile.ts), with overtime as
  // an extra entry. A list of { home, away }; null until anything is entered.
  // For volleyball homeScore/awayScore are the sets won, worked out from these.
  periodScores        Json?      @map("period_scores")
  status              GameStatus @default(SCHEDULED)
  round               Int?
  // True once this game has an event log. Its scores and player statistics are
  // then derived from that log and must not be edited directly. Games recorded
  // before the log existed stay false and keep their hand-entered figures.
  eventsAuthoritative Boolean    @default(false) @map("events_authoritative")
  // A confirmed game is a closed record: its report cannot be changed until
  // someone with season access reopens it and says why.
  confirmedAt         DateTime?  @map("confirmed_at")
  confirmedById       String?    @map("confirmed_by_id")
  confirmedBy         User?      @relation("GameConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  seasonId String @map("season_id")
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  homeTeamId String @map("home_team_id")
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)

  awayTeamId String                @map("away_team_id")
  awayTeam   Team                  @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  statistic  PlayerGameStatistic[] @relation("GameStatistic")
  events     MatchEvent[]
  teamEvents TeamEvent[]

  // Set on a play-off game: the series it belongs to. Play-off games never
  // count in the table (services/standings/filters.ts) and are created and
  // removed by the bracket (services/playoff/sync.ts), not by hand.
  playoffSeriesId String?        @map("playoff_series_id")
  playoffSeries   PlayoffSeries? @relation(fields: [playoffSeriesId], references: [id], onDelete: Cascade)

  // The results email this game went out in. Null while it has not been mailed,
  // which is what the results email screen offers to send.
  digestId String?       @map("digest_id")
  digest   SeasonDigest? @relation(fields: [digestId], references: [id], onDelete: SetNull)

  @@index([seasonId, digestId])
  @@index([playoffSeriesId])
  @@map("games")
}

enum PlayoffRound {
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
  BRONZE
}

/// One pairing of a season's play-off bracket, played as a best-of series.
/// Its games are ordinary games, created once both teams are known. Seeds
/// stand in for the teams until the regular season is settled; a team with a
/// bye starts in the second round with its seed already placed.
model PlayoffSeries {
  id       String       @id @default(uuid())
  round    PlayoffRound
  slot     Int
  bestOf   Int          @map("best_of")
  homeSeed Int?         @map("home_seed")
  awaySeed Int?         @map("away_seed")

  homeTeamId   String? @map("home_team_id")
  homeTeam     Team?   @relation("PlayoffSeriesHome", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId   String? @map("away_team_id")
  awayTeam     Team?   @relation("PlayoffSeriesAway", fields: [awayTeamId], references: [id], onDelete: SetNull)
  winnerTeamId String? @map("winner_team_id")
  winnerTeam   Team?   @relation("PlayoffSeriesWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)

  seasonId String @map("season_id")
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  games Game[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, round, slot])
  @@map("playoff_series")
}

// A results email that has gone out, so the same games are not mailed twice by
// accident and the manager can see when it last went and to how many people.
// A round summary names its round; an email of hand-picked games has none and
// is known by the games linked to it.
model SeasonDigest {
  id    String @id @default(uuid())
  round Int?

  seasonId String @map("season_id")
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  sentAt         DateTime @default(now()) @map("sent_at")
  recipientCount Int      @default(0) @map("recipient_count")

  sentById String? @map("sent_by_id")
  sentBy   User?   @relation("DigestSender", fields: [sentById], references: [id], onDelete: SetNull)

  games Game[]

  @@unique([seasonId, round])
  @@map("season_digests")
}

// Anything a team turns up to: a league fixture, a training session, a meeting.
// A fixture is mirrored here rather than replaced, so the calendar a player sees
// is one list while the competition keeps owning its own schedule.
enum TeamEventType {
  MATCH
  TRAINING
  MEETING
  OTHER
}

enum AttendanceStatus {
  ATTENDING
  NOT_ATTENDING
  MAYBE
  NO_RESPONSE
}

model TeamEvent {
  id          String        @id @default(uuid())
  type        TeamEventType @default(OTHER)
  title       String
  description String?
  startsAt    DateTime      @map("starts_at")
  endsAt      DateTime?     @map("ends_at")
  location    String?

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  // Set when this event mirrors a league fixture. Cleared rather than deleted if
  // the fixture goes, because the team may still have met that evening.
  gameId String? @map("game_id")
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: SetNull)

  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("TeamEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attendances Attendance[]

  // One team cannot hold two events for the same fixture.
  @@unique([teamId, gameId])
  @@index([teamId, startsAt])
  @@map("team_events")
}

// Who is coming. Keyed on the roster row rather than on an account: most players
// never sign in, and a manager answers for them.
model Attendance {
  id     String           @id @default(uuid())
  status AttendanceStatus @default(NO_RESPONSE)
  note   String?

  eventId String    @map("event_id")
  event   TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  playerId String @map("player_id")
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Who actually answered: the player, or the manager answering on their behalf.
  respondedById String?   @map("responded_by_id")
  respondedBy   User?     @relation("AttendanceResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt   DateTime? @map("responded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventId, playerId])
  @@index([playerId])
  @@map("attendances")
}

// An administrative change worth being able to explain later: who did it, when,
// what the record looked like before and after, and why.
//
// Deliberately not a foreign key to the thing it describes. An audit row has to
// outlive the row it is about, so deleting a game must not take the record of
// its deletion with it.
model AuditLog {
  id         String  @id @default(uuid())
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  action     String
  before     Json?
  after      Json?
  // Required by the routes that reopen a confirmed record, optional elsewhere.
  reason     String?

  actorId String? @map("actor_id")
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  // The admin audit list: newest first, optionally one section.
  @@index([createdAt])
  @@index([entityType, createdAt])
  @@map("audit_log")
}

// What happened in a game, as it happened. Player statistics, the final score
// and the period scores are all derived from these rows, so a correction is
// made once here rather than in four places that can disagree.
enum MatchEventType {
  GOAL
  PENALTY
  GOALIE_CHANGE
  // Football: a yellow or red card (cardColor).
  CARD
  TIMEOUT
  PERIOD_START
  PERIOD_END
  SHOOTOUT_ATTEMPT
}

enum CardColor {
  YELLOW
  RED
}

model MatchEvent {
  id     String         @id @default(uuid())
  type   MatchEventType
  // Period 1..n, counted from the start of the game. Overtime and shootout
  // continue the count rather than needing a flag of their own.
  period Int            @default(1)
  // Elapsed time within the period. Optional: a scoresheet is often filled in
  // afterwards from memory, with the order known but not the clock.
  minute Int?
  second Int?

  gameId String @map("game_id")
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // Which side the event belongs to. Required even when no player is named, so
  // a goal still counts toward the right team if its scorer is later removed.
  teamId String @map("team_id")
  team   Team   @relation("MatchEventTeam", fields: [teamId], references: [id], onDelete: Restrict)

  // The player the event is credited to: scorer, penalised player, goalie going
  // in. Null once that roster row is deleted - the event itself still happened.
  playerId String? @map("player_id")
  player   Player? @relation("MatchEventPlayer", fields: [playerId], references: [id], onDelete: SetNull)

  assistPlayerId String? @map("assist_player_id")
  assistPlayer   Player? @relation("MatchEventAssist", fields: [assistPlayerId], references: [id], onDelete: SetNull)

  secondaryAssistPlayerId String? @map("secondary_assist_player_id")
  secondaryAssistPlayer   Player? @relation("MatchEventSecondaryAssist", fields: [secondaryAssistPlayerId], references: [id], onDelete: SetNull)

  // PENALTY only.
  penaltyMinutes Int?    @map("penalty_minutes")
  penaltyType    String? @map("penalty_type")

  // CARD only.
  cardColor CardColor? @map("card_color")

  note String?

  // Who recorded it. Kept when the account goes so the trail does not vanish
  // with the person.
  recordedById String?  @map("recorded_by_id")
  recordedBy   User?    @relation("MatchEventRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([gameId])
  @@index([playerId])
  @@map("match_events")
}

/// One player's line in one game. Which of the numbers a sport keeps comes from
/// its profile (services/sports/profile.ts); the others stay null.
model PlayerGameStatistic {
  id             String @id @default(uuid())
  playerId       String @map("player_id")
  player         Player @relation("PlayerStatistic", fields: [playerId], references: [id], onDelete: Cascade)
  gameId         String @map("game_id")
  game           Game   @relation("GameStatistic", fields: [gameId], references: [id], onDelete: Cascade)
  goals          Int?
  assists        Int?
  penaltyMinutes Int?   @map("penalty_minutes")
  yellowCards    Int?   @map("yellow_cards")
  redCards       Int?   @map("red_cards")
  points         Int?
  fouls          Int?

  @@unique([playerId, gameId])
  @@map("player_game_statistics")
}

model SeasonArchiveStanding {
  id       String @id @default(uuid())
  seasonId String @map("season_id")
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  teamId           String? @map("team_id")
  team             Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamName         String  @map("team_name")
  teamLogo         String? @map("team_logo")
  teamPrimaryColor String? @map("team_primary_color")

  rank         Int
  played       Int
  wins         Int
  draws        Int
  losses       Int
  goalsFor     Int      @map("goals_for")
  goalsAgainst Int      @map("goals_against")
  points       Int
  // The volleyball table's split and its balls; see services/standings/compute.
  otWins            Int @default(0) @map("ot_wins")
  otLosses          Int @default(0) @map("ot_losses")
  partPointsFor     Int @default(0) @map("part_points_for")
  partPointsAgainst Int @default(0) @map("part_points_against")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([seasonId, teamId])
  @@map("season_archive_standings")
}

model SeasonArchivePlayerStat {
  id       String @id @default(uuid())
  seasonId String @map("season_id")
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  playerId     String? @map("player_id")
  player       Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerName   String  @map("player_name")
  playerNumber Int?    @map("player_number")

  teamId   String? @map("team_id")
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamName String  @map("team_name")

  gamesPlayed    Int      @map("games_played")
  goals          Int
  assists        Int
  penaltyMinutes Int      @default(0) @map("penalty_minutes")
  yellowCards    Int      @default(0) @map("yellow_cards")
  redCards       Int      @default(0) @map("red_cards")
  points         Int      @default(0)
  fouls          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([seasonId, playerId])
  @@map("season_archive_player_stats")
}

// ============================================================
// TOURNAMENT
// ============================================================

enum TournamentStatus {
  DRAFT
  REGISTRATION
  GROUP_STAGE
  PLAYOFF
  COMPLETED
}

enum TournamentGamePhase {
  GROUP
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  BRONZE
  FINAL
}

model TournamentSeries {
  id          String     @id @default(uuid())
  name        String
  sportType   SportType  @default(OTHER) @map("sport_type")
  logo        String?
  description String?
  // Scoring override inherited by every tournament in the series; null falls
  // back to the sport default.
  scoring     Json?
  // Carried by the series, like its manager: every edition inherits it.
  visibility  Visibility @default(PUBLIC)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  managerId String? @map("manager_id")
  manager   User?   @relation(fields: [managerId], references: [id], onDelete: SetNull)

  tournaments Tournament[]

  @@map("tournament_series")
}

model Tournament {
  id        String           @id @default(uuid())
  name      String
  year      Int?
  status    TournamentStatus @default(DRAFT)
  // Overrides the series scoring for this tournament only; null inherits.
  scoring   Json?
  startDate DateTime?        @map("start_date")
  endDate   DateTime?        @map("end_date")
  location  String?
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  seriesId String           @map("series_id")
  series   TournamentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  teams  TournamentTeam[]
  groups TournamentGroup[]
  games  TournamentGame[]

  registrationWindow RegistrationWindow?

  // What the organiser paid for. A series manager's Organizer plan, while it
  // runs, lifts every tournament of theirs above this; see tournamentPlan.ts.
  plan     TournamentPlan @default(FREE)
  payments Payment[]

  @@map("tournaments")
}

model TournamentTeam {
  id           String   @id @default(uuid())
  name         String
  logo         String?
  primaryColor String?  @map("primary_color")
  country      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  players    TournamentPlayer[]
  groupTeams TournamentGroupTeam[]
  homeGames  TournamentGame[]      @relation("TournamentHomeTeam")
  awayGames  TournamentGame[]      @relation("TournamentAwayTeam")

  registration Registration?

  @@map("tournament_teams")
}

model TournamentPlayer {
  id        String          @id @default(uuid())
  name      String
  number    Int?
  position  PlayerPosition?
  bornYear  Int?            @map("born_year")
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  teamId String         @map("team_id")
  team   TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  statistics TournamentGameStatistic[]

  @@map("tournament_players")
}

model TournamentGroup {
  id   String @id @default(uuid())
  name String

  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  teams TournamentGroupTeam[]
  games TournamentGame[]

  @@map("tournament_groups")
}

model TournamentGroupTeam {
  groupId String @map("group_id")
  teamId  String @map("team_id")

  group TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team  TournamentTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamId])
  @@map("tournament_group_teams")
}

model TournamentGame {
  id          String              @id @default(uuid())
  phase       TournamentGamePhase
  homeScore   Int?                @map("home_score")
  awayScore   Int?                @map("away_score")
  // Set scores of a volleyball game, as on Game; the score follows from them.
  periodScores Json?              @map("period_scores")
  date        DateTime?
  location    String?
  status      GameStatus          @default(SCHEDULED)
  bracketSlot Int?                @map("bracket_slot")
  homeSeed    Int?                @map("home_seed")
  awaySeed    Int?                @map("away_seed")
  note        String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  groupId String?          @map("group_id")
  group   TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  homeTeamId String?         @map("home_team_id")
  homeTeam   TournamentTeam? @relation("TournamentHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)

  awayTeamId String?         @map("away_team_id")
  awayTeam   TournamentTeam? @relation("TournamentAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)

  statistics TournamentGameStatistic[]

  @@map("tournament_games")
}

model TournamentGameStatistic {
  id      String @id @default(uuid())
  goals   Int?
  assists Int?

  gameId String         @map("game_id")
  game   TournamentGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  playerId String           @map("player_id")
  player   TournamentPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([gameId, playerId])
  @@map("tournament_game_statistics")
}

// ============================================================
// SUPPORT
// ============================================================

enum SupportCategory {
  QUESTION
  PROBLEM
  COMPLAINT
  IDEA
}

enum SupportTicketStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

// A message sent through /contact. Anyone may send one, signed in or not.
model SupportTicket {
  id       String              @id @default(uuid())
  category SupportCategory
  subject  String
  message  String
  // Only where the sender wants a reply.
  email    String?
  // Page, device and viewport - only when the sender ticked the box for it.
  context  Json?
  status   SupportTicketStatus @default(NEW)

  // Generated by the form once per message. A retried or double-tapped submit
  // carries the same token and gets the first ticket back instead of a second.
  clientToken String @unique @map("client_token")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("support_tickets")
}

enum RegistrationStatus {
  PENDING
  WAITLISTED
  APPROVED
  REJECTED
  WITHDRAWN
}

/// The sign-up form of one season or one tournament (exactly one of the two,
/// enforced by a CHECK constraint). Teams apply while it is open and before
/// the deadline; the manager decides each application.
model RegistrationWindow {
  id           String      @id @default(uuid())
  seasonId     String?     @unique @map("season_id")
  season       Season?     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tournamentId String?     @unique @map("tournament_id")
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  open         Boolean   @default(false)
  deadline     DateTime?
  // Teams the competition takes; past it, new applications join the waiting list.
  maxTeams     Int?      @map("max_teams")
  // Rules the applicant must accept. The version goes up whenever the text
  // changes, so each application records which text was accepted.
  rules        String?
  rulesVersion Int       @default(1) @map("rules_version")
  // Entry fee as plain text ("1 500 Kč per team, pay by 30 June").
  fee          String?
  // First time the manager opened the form, and the last time they closed it.
  // A window never published is still a draft.
  publishedAt  DateTime? @map("published_at")
  closedAt     DateTime? @map("closed_at")

  registrations Registration[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("registration_windows")
}

/// One team's application to a season or tournament. A season application
/// comes from a signed-in user, who manages the team once approved; a
/// tournament one needs only an email address.
model Registration {
  id       String             @id @default(uuid())
  windowId String             @map("window_id")
  window   RegistrationWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  status   RegistrationStatus @default(PENDING)

  applicantId String? @map("applicant_id")
  applicant   User?   @relation("RegistrationApplicant", fields: [applicantId], references: [id], onDelete: SetNull)
  contactName String  @map("contact_name")
  email       String
  phone       String?
  note        String?
  // Language of the emails about this application.
  locale      String  @default("cs")

  // A season applicant's own team returning for another season.
  existingTeamId String? @map("existing_team_id")
  existingTeam   Team?   @relation("RegistrationExistingTeam", fields: [existingTeamId], references: [id], onDelete: SetNull)
  teamName       String  @map("team_name")
  primaryColor   String? @map("primary_color")
  // Tournament only: [{ name, number?, position? }].
  roster         Json?

  rulesAcceptedAt DateTime? @map("rules_accepted_at")
  rulesVersion    Int?      @map("rules_version")

  decidedAt   DateTime? @map("decided_at")
  decidedById String?   @map("decided_by_id")
  decidedBy   User?     @relation("RegistrationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  reason      String?
  withdrawnAt DateTime? @map("withdrawn_at")

  // A waitlisted application the manager moved up to the queue. Moving one up
  // ahead of an older one is flagged, so the order can be accounted for.
  promotedAt         DateTime? @map("promoted_at")
  promotedById       String?   @map("promoted_by_id")
  promotedBy         User?     @relation("RegistrationPromoter", fields: [promotedById], references: [id], onDelete: SetNull)
  promotedOutOfOrder Boolean   @default(false) @map("promoted_out_of_order")

  // What the approval created or added.
  teamId           String?         @map("team_id")
  team             Team?           @relation("RegistrationTeam", fields: [teamId], references: [id], onDelete: SetNull)
  tournamentTeamId String?         @unique @map("tournament_team_id")
  tournamentTeam   TournamentTeam? @relation(fields: [tournamentTeamId], references: [id], onDelete: SetNull)

  // A retried submit returns the application that already arrived.
  clientToken     String  @unique @map("client_token")
  // The applicant's status link, for a tournament applicant with no account.
  // Only its hash is stored, as with manager invites.
  statusTokenHash String? @unique @map("status_token_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([windowId, status])
  @@index([applicantId])
  // The admin overview's "pending for over a week" queue.
  @@index([status, createdAt])
  @@map("registrations")
}

// ============================================================================
// PRICING, VAT AND PLAN LIMITS (celek G)
//
// Nothing here is edited in place. A change is a new row with the instant it
// takes effect; the row in force at a moment is the newest one whose
// `validFrom` is not after it. Payments (celek B) copy what applied when they
// were created, so later changes never touch an issued document.
// ============================================================================

/// Something ATM sells: TOURNAMENT, TOURNAMENT_PLUS, ORGANIZER_YEAR; league plans later.
model Product {
  id        String   @id @default(uuid())
  code      String   @unique
  nameCs    String   @map("name_cs")
  nameEn    String   @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  prices ProductPrice[]

  @@map("products")
}

/// One version of a product's price, VAT included. EUR is a fixed price of
/// its own, never converted from CZK.
model ProductPrice {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  // Minor units: haléře and cents.
  priceCzk  Int      @map("price_czk")
  priceEur  Int      @map("price_eur")
  validFrom DateTime @map("valid_from")

  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("PriceAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId, validFrom])
  @@map("product_prices")
}

/// One version of a country's standard VAT rate.
model VatRate {
  id        String   @id @default(uuid())
  // ISO 3166 alpha-2 (GR for Greece, even though VIES says EL).
  country   String
  // Hundredths of a percent: 2100 is 21 %.
  rateBp    Int      @map("rate_bp")
  validFrom DateTime @map("valid_from")

  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("VatRateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([country, validFrom])
  @@map("vat_rates")
}

/// One version of one limit of one plan. `value` null means unlimited.
model PlanLimit {
  id        String   @id @default(uuid())
  // FREE, TOURNAMENT, TOURNAMENT_PLUS, ORGANIZER
  plan      String
  // TEAMS_PER_TOURNAMENT, SPONSOR_LOGOS, DOCUMENTS, DOCUMENT_MAX_MB, LOGO_MAX_MB
  key       String
  value     Int?
  validFrom DateTime @map("valid_from")

  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("PlanLimitAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([plan, key, validFrom])
  @@map("plan_limits")
}

/// Switches an admin changes at run time, e.g. `oss` = { enabled }.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum VatCheckStatus {
  VALID
  INVALID
  // VIES did not answer. Czech VAT applies until a retry gets an answer.
  UNAVAILABLE
}

/// One VIES lookup of an EU VAT ID: the evidence behind charging 0 % under
/// reverse charge. A payment (celek B) points at the check it relied on.
model VatCheck {
  id                String         @id @default(uuid())
  // VIES country code (EL for Greece) and the number without it.
  countryCode       String         @map("country_code")
  vatNumber         String         @map("vat_number")
  status            VatCheckStatus
  name              String?
  address           String?
  // The consultation number VIES issues when ATM's own VAT ID is sent along.
  requestIdentifier String?        @map("request_identifier")
  requestDate       DateTime?      @map("request_date")
  response          Json?
  attempts          Int            @default(1)
  // Set while UNAVAILABLE: when the retry job asks again.
  nextRetryAt       DateTime?      @map("next_retry_at")
  checkedAt         DateTime       @map("checked_at")

  requestedById String? @map("requested_by_id")
  requestedBy   User?   @relation("VatCheckRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([countryCode, vatNumber, checkedAt])
  @@index([status, nextRetryAt])
  @@map("vat_checks")
}

// What a stored file belongs to. Polymorphic like AuditLog, without a foreign
// key: the object in the bucket has to be removed by the app, so a cascade
// would only orphan it. Null owner = uploaded, not yet saved on anything.
enum FileOwnerType {
  TEAM
  TOURNAMENT_TEAM
  TOURNAMENT
  TOURNAMENT_SERIES
  LEAGUE
}

enum FileKind {
  LOGO
  SPONSOR_LOGO
  DOCUMENT
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

// A file in storage (R2 in production, the local disk in development).
// Logo columns keep holding a URL; this row is how the app knows the URL is
// its own and when nothing references it any more.
model StoredFile {
  id         String         @id @default(uuid())
  key        String         @unique
  // Public files only; private ones are reached through signed links.
  url        String?        @unique
  kind       FileKind
  visibility FileVisibility
  ownerType  FileOwnerType? @map("owner_type")
  ownerId    String?        @map("owner_id")
  mimeType   String         @map("mime_type")
  size       Int
  width      Int?
  height     Int?
  // The external link a logo was imported from, if it was.
  sourceUrl  String?        @map("source_url")

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerType, ownerId])
  @@index([createdAt])
  @@map("files")
}

// ============================================================================
// TOURNAMENT PLANS AND PAYMENTS (celek B)
// ============================================================================

enum TournamentPlan {
  FREE
  TOURNAMENT
  TOURNAMENT_PLUS
}

/// The yearly Organizer plan: while it runs, every tournament in a series its
/// holder manages has no team limit. Nothing is deleted when it ends.
model OrganizerPlan {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation("OrganizerPlanHolder", fields: [userId], references: [id], onDelete: Cascade)
  validFrom  DateTime @map("valid_from")
  validUntil DateTime @map("valid_until")

  paymentId String?  @unique @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, validUntil])
  @@map("organizer_plans")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

/// One QR transfer to ATM. `snapshot` is the PriceSnapshot quote() returned
/// when the payment was created, so later price or VAT changes never touch it.
model Payment {
  id             String        @id @default(uuid())
  // Ten digits from a sequence that starts at 2026000001.
  variableSymbol Int           @unique @default(autoincrement()) @map("variable_symbol")
  productCode    String        @map("product_code")
  status         PaymentStatus @default(PENDING)
  currency       String
  // Minor units, VAT included; the same as snapshot.gross.
  amount         Int
  snapshot       Json

  payerId      String?     @map("payer_id")
  payer        User?       @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: SetNull)
  tournamentId String?     @map("tournament_id")
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  confirmedAt   DateTime? @map("confirmed_at")
  confirmedById String?   @map("confirmed_by_id")
  confirmedBy   User?     @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime? @map("cancelled_at")

  organizerPlan OrganizerPlan?
  taxDocument   TaxDocument?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([payerId])
  @@index([tournamentId])
  @@map("payments")
}

enum TaxDocumentKind {
  // Without the customer's details; allowed up to 10 000 Kč.
  SIMPLIFIED
  // With the customer's name, address and IČO or DIČ (celek B6).
  FULL
}

/// A tax document Conesoft issues for a confirmed payment. `content` holds
/// everything printed on it, so the PDF can be rendered again at any time and
/// comes out the same; nothing in it is looked up again later.
model TaxDocument {
  id         String          @id @default(uuid())
  // ATM + the year's last two digits + the sequence, e.g. ATM26-0001; no gaps within a year.
  number     String          @unique
  year       Int
  sequence   Int
  kind       TaxDocumentKind
  paymentId  String          @unique @map("payment_id")
  payment    Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  issuedAt   DateTime        @map("issued_at")
  // Datum uskutečnění zdanitelného plnění.
  taxPointAt DateTime        @map("tax_point_at")
  content    Json
  // The rendered PDF in private storage, once it has been written.
  fileKey    String?         @map("file_key")
  emailedAt  DateTime?       @map("emailed_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([year, sequence])
  @@map("tax_documents")
}

/// The last tax document number used in a year. Taken inside the transaction
/// that confirms the payment, so a rolled-back confirmation leaves no gap.
model DocumentCounter {
  year Int @id
  last Int @default(0)

  @@map("document_counters")
}

// ============================================================================
// EMBEDDED WIDGET (celek I)
// ============================================================================

enum EmbedKind {
  SEASON
  TOURNAMENT
}

/// How often a competition's widget was shown on another website, per site
/// and day. No cookie and nothing about the visitor: only the embedding
/// site's host name, which the widget reads from document.referrer.
model EmbedView {
  id            String    @id @default(uuid())
  kind          EmbedKind
  competitionId String    @map("competition_id")
  // Host name of the page the widget is embedded in; "" when unknown.
  site          String
  day           DateTime  @db.Date
  views         Int       @default(0)

  @@unique([kind, competitionId, site, day])
  @@index([day])
  @@map("embed_views")
}
